# ============================================
# Healthcare Appointment System — Environment
# ============================================
# Copy this file to .env and fill in real values.

PORT=5000
MONGO_URI=mongodb://localhost:27017/healthcare_app
# Generate a random secret (at least 32 characters); the placeholder is rejected.
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Gmail SMTP: enable locally and supply a Google App Password (not the login password).
EMAIL_ENABLED=false
SMTP_USER=
SMTP_APP_PASSWORD=
