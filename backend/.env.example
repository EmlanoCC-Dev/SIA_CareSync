# ============================================
# Healthcare Appointment System — Environment
# ============================================
# Copy this file to .env and fill in real values.

PORT=5000
MONGO_URI=mongodb://localhost:27017/healthcare_app
# Generate a random secret (at least 32 characters); the placeholder is rejected.
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
TZ=Asia/Manila
# Exact browser origins, comma-separated. Empty allows all only during development.
CORS_ORIGINS=
# Set 1 behind Render's proxy; keep 0 for direct local access.
TRUST_PROXY=0
# Local development uses disk; free hosting must use gridfs for persistence.
UPLOAD_STORAGE=local

# Gmail SMTP: enable locally and supply a Google App Password (not the login password).
EMAIL_ENABLED=false
EMAIL_TRANSPORT=smtp
SMTP_USER=
SMTP_APP_PASSWORD=

# Render Free blocks SMTP. Set EMAIL_TRANSPORT=gmail-api and use these secrets.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Database backups: same Google account/client as email, separate Drive consent/token.
# The app creates a private CareSync Database Backups folder using drive.file permission.
BACKUP_ENABLED=false
DRIVE_REFRESH_TOKEN=
# 32 random bytes encoded as base64. Keep a separate offline copy for restoration.
BACKUP_ENCRYPTION_KEY=
# Separate random secret (at least 32 characters) used only by the external daily job.
BACKUP_SCHEDULER_TOKEN=
# Optional absolute mongodump executable path; defaults to backend/bin/mongodump(.exe).
MONGODUMP_PATH=
